{
  "name": "huiye-ai-diary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "local": "vinext dev --host 127.0.0.1 --port 4317",
    "local:import": "node scripts/import-local-data.mjs",
    "local:verify": "node scripts/verify-local-data.mjs",
    "local:prune": "node scripts/prune-local-data.mjs",
    "local:verify-echoes": "node scripts/verify-echo-records.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/local-data-store.test.mjs tests/thought-line-model.test.mjs tests/portfolio-analytics.test.mjs tests/echo-candidate-controller.test.mjs tests/lined-editor-model.test.mjs && node --test tests/lined-editor-browser.test.mjs",
    "test:lined-editor-browser": "node --test tests/lined-editor-browser.test.mjs",
    "test:portfolio-analytics": "node --experimental-strip-types --test tests/portfolio-analytics.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "node": "^22.23.1",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
