<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Huiye_ThoughtLine" targetNamespace="https://huiye.local/bpmn">
  <bpmn:process id="Process_Huiye_ThoughtLine" name="回页 · 思考线与回响用户流程" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Huiye">
      <bpmn:lane id="Lane_Write" name="01 · 用户写下">
        <bpmn:flowNodeRef>Start_Write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssignLine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignLines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KeepInPool</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ThoughtLine" name="02 · 用户查看思考线">
        <bpmn:flowNodeRef>Task_OpenLine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadTimeline</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="03 · AI 在线内观察">
        <bpmn:flowNodeRef>Task_CheckCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObserveChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WorthEchoing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateEcho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StayQuiet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Echo" name="04 · 正式回响">
        <bpmn:flowNodeRef>Task_GentleCue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenEcho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UserChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LeaveSpace</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Evaluation" name="05 · 当前回响评测">
        <bpmn:flowNodeRef>Task_CreateCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JudgeCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefineRules</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Write" name="此刻想留下一点什么"/>
    <bpmn:userTask id="Task_SaveEntry" name="保存 Entry"/>
    <bpmn:exclusiveGateway id="Gateway_AssignLine" name="是否加入思考线"/>
    <bpmn:userTask id="Task_AssignLines" name="选择一条或多条思考线"/>
    <bpmn:userTask id="Task_KeepInPool" name="留在日记池"/>
    <bpmn:userTask id="Task_OpenLine" name="打开思考线"/>
    <bpmn:userTask id="Task_ReadTimeline" name="查看预览、原文与回响点"/>
    <bpmn:businessRuleTask id="Task_CheckCandidate" name="检查同线、数量与双重权限"/>
    <bpmn:serviceTask id="Task_ObserveChange" name="观察延续、修正、分支、冲突或未解决问题"/>
    <bpmn:exclusiveGateway id="Gateway_WorthEchoing" name="值得现在带回吗"/>
    <bpmn:serviceTask id="Task_CreateEcho" name="形成 EchoRecord"/>
    <bpmn:endEvent id="End_StayQuiet" name="保持安静"/>
    <bpmn:userTask id="Task_GentleCue" name="回响入口出现小棕点"/>
    <bpmn:userTask id="Task_OpenEcho" name="原句到全文，再看 AI 初判"/>
    <bpmn:exclusiveGateway id="Gateway_UserChoice" name="用户自由选择"/>
    <bpmn:serviceTask id="Task_RecordFeedback" name="记录可选反馈"/>
    <bpmn:userTask id="Task_SaveResponse" name="保存独立 EchoReply"/>
    <bpmn:endEvent id="End_LeaveSpace" name="本次结束，留下空白"/>
    <bpmn:manualTask id="Task_CreateCase" name="生成真实线内评测 case"/>
    <bpmn:manualTask id="Task_JudgeCase" name="判断 good / bad 并归因"/>
    <bpmn:manualTask id="Task_RefineRules" name="积累标准并迭代 Prompt 与规则"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Write" targetRef="Task_SaveEntry"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SaveEntry" targetRef="Gateway_AssignLine"/>
    <bpmn:sequenceFlow id="Flow_03" name="是" sourceRef="Gateway_AssignLine" targetRef="Task_AssignLines"/>
    <bpmn:sequenceFlow id="Flow_04" name="否" sourceRef="Gateway_AssignLine" targetRef="Task_KeepInPool"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_AssignLines" targetRef="Task_OpenLine"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_OpenLine" targetRef="Task_ReadTimeline"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AssignLines" targetRef="Task_CheckCandidate"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CheckCandidate" targetRef="Task_ObserveChange"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ObserveChange" targetRef="Gateway_WorthEchoing"/>
    <bpmn:sequenceFlow id="Flow_10" name="否" sourceRef="Gateway_WorthEchoing" targetRef="End_StayQuiet"/>
    <bpmn:sequenceFlow id="Flow_11" name="是" sourceRef="Gateway_WorthEchoing" targetRef="Task_CreateEcho"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CreateEcho" targetRef="Task_GentleCue"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_GentleCue" targetRef="Task_OpenEcho"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_OpenEcho" targetRef="Gateway_UserChoice"/>
    <bpmn:sequenceFlow id="Flow_15" name="沉默或回味" sourceRef="Gateway_UserChoice" targetRef="End_LeaveSpace"/>
    <bpmn:sequenceFlow id="Flow_16" name="反馈" sourceRef="Gateway_UserChoice" targetRef="Task_RecordFeedback"/>
    <bpmn:sequenceFlow id="Flow_17" name="回应" sourceRef="Gateway_UserChoice" targetRef="Task_SaveResponse"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RecordFeedback" targetRef="End_LeaveSpace"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SaveResponse" targetRef="End_LeaveSpace"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CreateEcho" targetRef="Task_CreateCase"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CreateCase" targetRef="Task_JudgeCase"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_JudgeCase" targetRef="Task_RefineRules"/>
  </bpmn:process>
</bpmn:definitions>
