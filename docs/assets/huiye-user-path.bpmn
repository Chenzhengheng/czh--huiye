<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Huiye" targetNamespace="https://huiye.local/bpmn">
  <bpmn:process id="Process_HuiyeUserPath" name="回页用户路径" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Huiye">
      <bpmn:lane id="Lane_Writing" name="01 · 写作">
        <bpmn:flowNodeRef>Start_Write</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Write</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmSave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContinueEcho</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmContinuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Chat</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Chat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool" name="02 · 日记池">
        <bpmn:flowNodeRef>Task_SaveEntry</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeSave</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_EchoPermission</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_MarkEligible</bpmn:flowNodeRef><bpmn:flowNodeRef>End_SavedOnly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveResultEntry</bpmn:flowNodeRef><bpmn:flowNodeRef>Start_Search</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Search</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ViewEntry</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveEntry</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_FoundEntry</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NoFabrication</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ChatNoMatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Echo" name="03 · 回响">
        <bpmn:flowNodeRef>Task_DiscoverCandidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Quality</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Silent</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_EchoMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RelationalEcho</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RevisitEcho</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeMode</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_TimeOffset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenEcho</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EchoCard</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Continue</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordFeedback</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordContinuation</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ChatEcho</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Write" name="开始写"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Write" name="主动写下一篇日记"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmSave" name="用户确认保存"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_SaveEntry" name="写入 Entry（local-data 权威原文）"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeSave" name="合并保存入口" gatewayDirection="Converging"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_EchoPermission" name="允许参与回响？" gatewayDirection="Diverging"><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SavedOnly" name="仅保存"><bpmn:incoming>Flow_06</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_MarkEligible" name="标记可回响（保留用户权限）"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DiscoverCandidate" name="发现候选关系（自动流程尚未开发）"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Quality" name="达到质量门槛？" gatewayDirection="Diverging"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Silent" name="保持安静"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_EchoMode" name="选择回响类型" gatewayDirection="Diverging"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RelationalEcho" name="联系回响 · 约 80%（A + B → C）"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RevisitEcho" name="回看回响 · 约 20%（A + 现在 → B）"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeMode" name="合并类型" gatewayDirection="Converging"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_TimeOffset" name="等待错位时间"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDefinition_TimeOffset"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_OpenEcho" name="用户打开回响（不在保存当下弹出）"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_EchoCard" name="展示回响卡片（原文证据 + AI 浓缩 + 问题）"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_40</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Continue" name="是否继续写？" gatewayDirection="Diverging"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordFeedback" name="记录反馈（没有感受 / 暂不回应）"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_NoResponse" name="本次结束"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_ContinueEcho" name="从回响继续写"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmContinuation" name="确认保存新思考"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_SaveResultEntry" name="写入结果 Entry（先保存正文，再记关系）"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RecordContinuation" name="记录 continuation_saved（关系进入已验证思考拓扑）"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:serviceTask>

    <bpmn:startEvent id="Start_Search" name="打开日记池"><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Search" name="搜索 / 筛选"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ViewEntry" name="查看或编辑原文"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_Search" name="返回日记池"><bpmn:incoming>Flow_32</bpmn:incoming></bpmn:endEvent>

    <bpmn:startEvent id="Start_Chat" name="发起对话"><bpmn:outgoing>Flow_33</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Chat" name="和 AI 聊聊（对话本身不自动保存）"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_RetrieveEntry" name="检索可引用 Entry（服从回响权限）"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_35</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FoundEntry" name="找到可核验原文？" gatewayDirection="Diverging"><bpmn:incoming>Flow_35</bpmn:incoming><bpmn:outgoing>Flow_36</bpmn:outgoing><bpmn:outgoing>Flow_38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NoFabrication" name="不引用过去，不假装理解用户"><bpmn:incoming>Flow_36</bpmn:incoming><bpmn:outgoing>Flow_37</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_ChatNoMatch" name="不虚构引用"><bpmn:incoming>Flow_37</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Task_ChatEcho" name="形成带出处的回响"><bpmn:incoming>Flow_38</bpmn:incoming><bpmn:outgoing>Flow_40</bpmn:outgoing></bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Write" targetRef="Task_Write"/><bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Write" targetRef="Task_ConfirmSave"/><bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ConfirmSave" targetRef="Task_SaveEntry"/><bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SaveEntry" targetRef="Gateway_MergeSave"/><bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_MergeSave" targetRef="Gateway_EchoPermission"/>
    <bpmn:sequenceFlow id="Flow_06" name="否" sourceRef="Gateway_EchoPermission" targetRef="End_SavedOnly"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not allowed</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_07" name="是" sourceRef="Gateway_EchoPermission" targetRef="Task_MarkEligible"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allowed</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_MarkEligible" targetRef="Task_DiscoverCandidate"/><bpmn:sequenceFlow id="Flow_09" sourceRef="Task_DiscoverCandidate" targetRef="Gateway_Quality"/>
    <bpmn:sequenceFlow id="Flow_10" name="否" sourceRef="Gateway_Quality" targetRef="End_Silent"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">below threshold</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_11" name="是" sourceRef="Gateway_Quality" targetRef="Gateway_EchoMode"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">qualified</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="联系" sourceRef="Gateway_EchoMode" targetRef="Task_RelationalEcho"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">relational</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_13" name="回看" sourceRef="Gateway_EchoMode" targetRef="Task_RevisitEcho"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reflective revisit</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RelationalEcho" targetRef="Gateway_MergeMode"/><bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RevisitEcho" targetRef="Gateway_MergeMode"/><bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_MergeMode" targetRef="Event_TimeOffset"/><bpmn:sequenceFlow id="Flow_17" sourceRef="Event_TimeOffset" targetRef="Task_OpenEcho"/><bpmn:sequenceFlow id="Flow_18" sourceRef="Task_OpenEcho" targetRef="Task_EchoCard"/><bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EchoCard" targetRef="Gateway_Continue"/>
    <bpmn:sequenceFlow id="Flow_20" name="否" sourceRef="Gateway_Continue" targetRef="Task_RecordFeedback"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no response</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_21" sourceRef="Task_RecordFeedback" targetRef="End_NoResponse"/>
    <bpmn:sequenceFlow id="Flow_23" name="是" sourceRef="Gateway_Continue" targetRef="Task_ContinueEcho"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">continue writing</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ContinueEcho" targetRef="Task_ConfirmContinuation"/><bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConfirmContinuation" targetRef="Task_SaveResultEntry"/><bpmn:sequenceFlow id="Flow_26" sourceRef="Task_SaveResultEntry" targetRef="Task_RecordContinuation"/><bpmn:sequenceFlow id="Flow_28" name="新 Entry 进入下一轮资格判断" sourceRef="Task_RecordContinuation" targetRef="Gateway_MergeSave"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Start_Search" targetRef="Task_Search"/><bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Search" targetRef="Task_ViewEntry"/><bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ViewEntry" targetRef="End_Search"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Start_Chat" targetRef="Task_Chat"/><bpmn:sequenceFlow id="Flow_34" sourceRef="Task_Chat" targetRef="Task_RetrieveEntry"/><bpmn:sequenceFlow id="Flow_35" sourceRef="Task_RetrieveEntry" targetRef="Gateway_FoundEntry"/><bpmn:sequenceFlow id="Flow_36" name="否" sourceRef="Gateway_FoundEntry" targetRef="Task_NoFabrication"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not found</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_37" sourceRef="Task_NoFabrication" targetRef="End_ChatNoMatch"/><bpmn:sequenceFlow id="Flow_38" name="是" sourceRef="Gateway_FoundEntry" targetRef="Task_ChatEcho"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">found</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_40" sourceRef="Task_ChatEcho" targetRef="Task_EchoCard"/>

    <bpmn:textAnnotation id="Annotation_Auto"><bpmn:text>规划：自动发现、质量判断与错位调度尚未开发；当前两条 EchoRecord 是人工校准候选。</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Auto" sourceRef="Task_DiscoverCandidate" targetRef="Annotation_Auto"/>
    <bpmn:textAnnotation id="Annotation_Chat"><bpmn:text>规划：AI 只引用允许回响且能够展示出处的真实 Entry；对话本身不自动保存。</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Chat" sourceRef="Task_Chat" targetRef="Annotation_Chat"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Huiye">
    <bpmndi:BPMNPlane id="Plane_Huiye" bpmnElement="Process_HuiyeUserPath">
      <bpmndi:BPMNShape id="DI_Lane_Writing" bpmnElement="Lane_Writing" isHorizontal="false"><dc:Bounds x="20" y="20" width="620" height="1060"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Pool" bpmnElement="Lane_Pool" isHorizontal="false"><dc:Bounds x="640" y="20" width="650" height="1060"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Echo" bpmnElement="Lane_Echo" isHorizontal="false"><dc:Bounds x="1290" y="20" width="890" height="1060"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DI_Start_Write" bpmnElement="Start_Write"><dc:Bounds x="62" y="122" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Write" bpmnElement="Task_Write"><dc:Bounds x="120" y="105" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_ConfirmSave" bpmnElement="Task_ConfirmSave"><dc:Bounds x="380" y="105" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_SaveEntry" bpmnElement="Task_SaveEntry"><dc:Bounds x="680" y="105" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_MergeSave" bpmnElement="Gateway_MergeSave" isMarkerVisible="true"><dc:Bounds x="878" y="108" width="64" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_EchoPermission" bpmnElement="Gateway_EchoPermission" isMarkerVisible="true"><dc:Bounds x="978" y="108" width="64" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_SavedOnly" bpmnElement="End_SavedOnly"><dc:Bounds x="992" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_MarkEligible" bpmnElement="Task_MarkEligible"><dc:Bounds x="1080" y="105" width="170" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_DiscoverCandidate" bpmnElement="Task_DiscoverCandidate"><dc:Bounds x="1330" y="105" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_Quality" bpmnElement="Gateway_Quality" isMarkerVisible="true"><dc:Bounds x="1558" y="108" width="64" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Silent" bpmnElement="End_Silent"><dc:Bounds x="1572" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_EchoMode" bpmnElement="Gateway_EchoMode" isMarkerVisible="true"><dc:Bounds x="1678" y="108" width="64" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RelationalEcho" bpmnElement="Task_RelationalEcho"><dc:Bounds x="1800" y="70" width="170" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RevisitEcho" bpmnElement="Task_RevisitEcho"><dc:Bounds x="1800" y="190" width="170" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_MergeMode" bpmnElement="Gateway_MergeMode" isMarkerVisible="true"><dc:Bounds x="1998" y="108" width="64" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Event_TimeOffset" bpmnElement="Event_TimeOffset"><dc:Bounds x="2084" y="114" width="52" height="52"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_OpenEcho" bpmnElement="Task_OpenEcho"><dc:Bounds x="1330" y="360" width="170" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_EchoCard" bpmnElement="Task_EchoCard"><dc:Bounds x="1550" y="360" width="210" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_Continue" bpmnElement="Gateway_Continue" isMarkerVisible="true"><dc:Bounds x="1808" y="363" width="64" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RecordFeedback" bpmnElement="Task_RecordFeedback"><dc:Bounds x="1940" y="500" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_NoResponse" bpmnElement="End_NoResponse"><dc:Bounds x="2132" y="552" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_ContinueEcho" bpmnElement="Task_ContinueEcho"><dc:Bounds x="120" y="480" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_ConfirmContinuation" bpmnElement="Task_ConfirmContinuation"><dc:Bounds x="380" y="480" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_SaveResultEntry" bpmnElement="Task_SaveResultEntry"><dc:Bounds x="680" y="480" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RecordContinuation" bpmnElement="Task_RecordContinuation"><dc:Bounds x="1330" y="480" width="210" height="70"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DI_Start_Search" bpmnElement="Start_Search"><dc:Bounds x="672" y="762" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Search" bpmnElement="Task_Search"><dc:Bounds x="740" y="745" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_ViewEntry" bpmnElement="Task_ViewEntry"><dc:Bounds x="990" y="745" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Search" bpmnElement="End_Search"><dc:Bounds x="1212" y="762" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DI_Start_Chat" bpmnElement="Start_Chat"><dc:Bounds x="62" y="942" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Chat" bpmnElement="Task_Chat"><dc:Bounds x="120" y="925" width="180" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RetrieveEntry" bpmnElement="Task_RetrieveEntry"><dc:Bounds x="690" y="925" width="190" height="70"/></bpmndi:BPMNShape>
